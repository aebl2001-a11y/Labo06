#include <iostream>
using namespace std;

int main() {
    int limite;
    int contador = 0;
    int suma = 0;

    cout << "Ingrese el numero limite: ";
    cin >> limite;

    cout << " NUMEROS IMPARES:" << endl;
    for (int i = 1; i <= limite; i += 2) {
        cout << i << endl;        
        contador++;        
        suma += i;       
    }

    cout << "-----------------------------------" << endl;
    cout << "Cantidad de numeros impares encontrados: " << contador << endl;
    cout << "Suma total de los impares: " << Suma << endl;

    return 0;
}